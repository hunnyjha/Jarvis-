# ============================================================
# JARVIS AI Operating System — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ── Application ─────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=jarvis_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://jarvis:change_me_strong_password@postgres:5432/jarvis_db

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379/0
REDIS_CACHE_TTL=3600

# ── ChromaDB ─────────────────────────────────────────────────
CHROMADB_URL=http://chromadb:8000
CHROMA_AUTH_TOKEN=change_me_chroma_token

# ── AI APIs ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# ── JWT Authentication ────────────────────────────────────────
JWT_SECRET_KEY=change_me_very_long_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Reddit API ────────────────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=JARVIS:v1.0.0 (by /u/your_username)
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# ── URLs ─────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Next.js Public ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=development

# ── Security ─────────────────────────────────────────────────
ALLOWED_HOSTS=["localhost","127.0.0.1"]
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# ── Storage ──────────────────────────────────────────────────
REPORTS_DIR=/app/storage/reports
MAX_UPLOAD_SIZE_MB=50
